{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Electronic Journey",
  "version": "0.1.0",
  "identifier": "com.electronicjourney.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Electronic Journey",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#f7f7f8",
        "center": true
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; img-src 'self' blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Your local digital journey archive",
    "longDescription": "A local-first desktop application that captures and organizes your own digital journey."
  }
}
