{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Electronic Journey",
  "version": "0.1.3",
  "identifier": "com.electronicjourney.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Electronic Journey",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#f7f7f8",
        "center": true
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; img-src 'self' blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Your local digital journey archive",
    "longDescription": "A local-first desktop application that captures and organizes your own digital journey.",
    "macOS": {
      "minimumSystemVersion": "15.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4NEY2M0U0M0IwNjI3MApSV1J3WXJCRFB2YUVDZG5GcWpIclNINmgyMEZ3cVE5czJ2R05wWUgycFk5K25ONFZTY3VCZklINAo=",
      "endpoints": [
        "https://github.com/AlieZVzz/electronic-journey/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
